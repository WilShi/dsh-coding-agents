{
  "name": "dsh-coding-agents",
  "version": "0.2.2",
  "description": "DSH control center for locally installed Codex and Claude Code: search and manage native sessions, run/resume/fork tasks, and edit configuration. · DSH 编程助手：统一管理、检索并直接控制 Codex 与 Claude Code。",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WilShi/dsh-coding-agents.git"
  },
  "homepage": "https://github.com/WilShi/dsh-coding-agents#readme",
  "bugs": {
    "url": "https://github.com/WilShi/dsh-coding-agents/issues"
  },
  "author": "WilShi",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./manager": {
      "types": "./lib/types/manager.d.ts",
      "default": "./lib/manager.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || ^24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-client.mjs && node scripts/verify-client.mjs",
    "build:host": "tsc -p tsconfig.build.json",
    "build:client": "node scripts/build-client.mjs && node scripts/verify-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --pool=threads --maxWorkers=1 --no-file-parallelism",
    "smoke:real": "node scripts/real-smoke.mjs",
    "smoke:real:execute": "node scripts/real-smoke.mjs --execute",
    "smoke:host": "node scripts/verify-host.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.263",
    "@anthropic-ai/sdk": "0.93.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@openai/codex": "0.153.4",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-sdk-protocol": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-subprocess": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.5",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.5",
    "@deepseek-ai/dsh-sdk-protocol": "0.2.1-rc.5",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.14",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.21.5",
    "happy-dom": "^15.11.7",
    "lightningcss": "^1.32.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  }
}
