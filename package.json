{
  "name": "dsh-coding-agents",
  "version": "0.1.0",
  "private": true,
  "description": "DSH control center for locally installed Codex and Claude Code",
  "author": "Wenbo Shi (WilShi)",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./manager": {
      "types": "./lib/manager.d.ts",
      "default": "./lib/manager.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**"
  ],
  "engines": {
    "node": "^22.19.0 || ^24.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --pool=threads --maxWorkers=1 --no-file-parallelism",
    "smoke:real": "node scripts/real-smoke.mjs",
    "smoke:real:execute": "node scripts/real-smoke.mjs --execute"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.263",
    "@anthropic-ai/sdk": "0.93.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@openai/codex": "0.153.4",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-sdk-protocol": "0.1.5-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.5-rc.2",
    "@deepseek-ai/dsh-http-proxy": "0.1.5-rc.2",
    "@deepseek-ai/dsh-sdk-protocol": "0.1.5-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.20.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "happy-dom": "^15.11.7",
    "lightningcss": "^1.32.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  }
}
